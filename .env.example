# Copy to .env (which is gitignored) and set a real password (>= 8 chars).
# docker-compose and src/kg/connection.py both read these.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_to_a_strong_password
NEO4J_URI=bolt://localhost:7687
# Optional: free Semantic Scholar API key (own rate pool for the Literature
# Monitor; the anonymous shared pool rate-limits aggressively)
# S2_API_KEY=
# Optional: LLM providers for the agent pipeline (src/agents/llm_client.py).
# GROQ_API_KEY=          # provider 'groq' — used by the extraction experiments
# ANTHROPIC_API_KEY=     # provider 'anthropic'
# OLLAMA_HOST=           # provider 'ollama'; defaults to http://localhost:11434
